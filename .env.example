# 이 파일을 복사해서 실제 값을 채운다. 실제 값이 든 .env 파일은 커밋하지 않는다.
#   웹:   apps/web/.env.local
#   워커: workers/.env
# 로컬 Supabase 값은 `npx supabase start` 출력에, 클라우드 값은 Supabase 대시보드 > Project Settings > API Keys에 있다.

# ---- 웹 (apps/web/.env.local) ----
# NEXT_PUBLIC_ 으로 시작하는 값은 브라우저에 노출된다. publishable 키는 노출돼도 되는 키이고, 권한은 RLS가 막는다.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# ---- 워커 (workers/.env) ----
# secret 키는 RLS를 우회한다. 워커와 GitHub Actions Secrets에만 둔다. 절대 NEXT_PUBLIC_ 을 붙이지 않는다.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=sb_secret_xxx
