# =====================================================================
# 1. 비밀값: 절대 올라가면 안 되는 것
#    한 번이라도 push되면 히스토리에 영구히 남는다. 그때는 키부터 재발급한다.
# =====================================================================

# 환경변수 파일 (API 키, DB 비밀번호, Supabase 키)
# 값이 비어 있는 .env.example만 커밋한다
.env
.env.*
!.env.example

# 인증서·개인키
*.pem
*.key


# =====================================================================
# 2. 생성물: 다시 만들 수 있어서 올릴 필요 없는 것
#    설치·빌드·실행하면 자동으로 생긴다. 지워져도 문제없다.
# =====================================================================

# ---- 의존성 (npm install / uv sync로 다시 설치) ----
node_modules/
jspm_packages/
web_modules/
bower_components
.pnpm-store
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.venv/

# ---- 빌드 결과물 ----
.next
out
dist
build/Release
*.tgz
lib-cov

# ---- 캐시 ----
*.tsbuildinfo
.npm
.eslintcache
.stylelintcache
.cache
.cache/
.parcel-cache
.turbo
.vite/
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# ---- 로그·실행 중 생기는 파일 ----
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
pids
*.pid
*.seed
*.pid.lock
.lock-wscript
.node_repl_history
.yarn-integrity
.tern-port

# ---- 테스트 커버리지 ----
coverage
*.lcov
.nyc_output

# ---- 다른 프레임워크·도구용 (GitHub Node 템플릿 기본값) ----
.grunt
.nuxt
.output
.vuepress/dist
.temp
.svelte-kit/
**/.vitepress/dist
**/.vitepress/cache
.docusaurus
.serverless/
.fusebox/
.dynamodb/
.firebase/
.vscode-test
.astro/


# =====================================================================
# 3. 데이터: 개인정보·수집 데이터라서 올리지 않는 것
#    비밀값은 아니지만 내 매매 기록이 공개되거나, 용량이 크거나,
#    데이터 제공처 약관상 재배포하면 안 되는 것들.
# =====================================================================

# 개인 거래내역 CSV, 수집 원본 (일봉·재무·공시·뉴스)
data/

# data/ 밖에 실수로 둔 데이터 파일도 막는다
# 테스트용 샘플이 필요하면 아래처럼 예외를 둔다
#   !workers/tests/fixtures/*.csv
*.csv
*.parquet
*.duckdb
*.xlsx
